{
  "name": "@foreman-code/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "node ../../scripts/ci-remote.mjs typecheck -- node ../../scripts/heavy-job.mjs -- tsc -b",
    "lint": "node ../../scripts/ci-remote.mjs lint -- node ../../scripts/heavy-job.mjs -- eslint . --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "node ../../scripts/ci-remote.mjs unit -- node ../../scripts/heavy-job.mjs -- sh -c \"corepack pnpm test:run-graph-smoke && corepack pnpm test:unit\"",
    "test:run-graph-smoke": "node ../../scripts/heavy-job.mjs -- node --test src/features/workflow-board/currentSource.smoke.mjs",
    "build": "node ../../scripts/heavy-job.mjs --build web -- sh -c \"tsc -b && vite build\"",
    "test:unit": "node ../../scripts/heavy-job.mjs -- sh -c \"FOREMAN_WEB_TEST_PHASE=fast vitest run && FOREMAN_WEB_TEST_PHASE=heavy vitest run\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@foreman-code/contracts": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "@xyflow/react": "12.11.6",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
