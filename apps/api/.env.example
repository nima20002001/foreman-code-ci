# Foreman Code settings. Existing GRAPHQL_* aliases remain supported; conflicting dual values fail.
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://graphql:graphql@127.0.0.1:5432/graphql
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=1000
READINESS_TIMEOUT_MS=2000
LANGGRAPH_CHECKPOINT_SCHEMA=langgraph
HARNESS_WORKSPACE_ROOT=/tmp/graphql-harness-runs
HARNESS_TIMEOUT_MS=21600000
# `codex` resolves to bundled 0.154.0. An absolute path to an existing qualified
# Codex 0.156.1 CLI uses that installed binary and its live model catalog.
CODEX_BINARY=codex

# New execution on connected Worker computers requires human startup opt-in.
# Main execution, existing history, cancellation and cleanup stay available.
FOREMAN_CODE_LAPTOP_EXECUTION_ENABLED=0

# Local frontend endpoint. Both services use this exact loopback origin; Vite uses a strict port.
# FOREMAN_CODE_WEB_PORT=5173
# FOREMAN_CODE_BROWSER_ORIGIN=http://127.0.0.1:5173

# Supported local Codex execution is enabled by default; native qualification still applies.
# Set these only to deliberately disable a local harness. Production restrictions are unchanged.
# FOREMAN_CODE_ENABLE_EXPERIMENTAL_CODEX_APP_SERVER=0
