{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["test", "src/**/*.test.ts", "src/**/*.testSupport.ts", "src/**/*.test-support.ts", "src/**/__tests__/**"]
}
